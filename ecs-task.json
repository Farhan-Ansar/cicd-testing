{
  "family": "node-app-tasks",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::767397727846:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "node-web-app",
      "image": "767397727846.dkr.ecr.ap-south-1.amazonaws.com/dev/nodeimages:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/node-app-tasks",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
